{
    "name": "wotz/filament-chatbot",
    "description": "Filament chatbot package with Laravel AI streaming support.",
    "keywords": [
        "wotzebra",
        "laravel",
        "filament",
        "chatbot"
    ],
    "homepage": "https://github.com/wotzebra/filament-chatbot",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.0 || ^4.0 || ^5.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
        "laravel/ai": "^0.2",
        "livewire/livewire": "^3.0 || ^4.0",
        "spatie/laravel-package-tools": "^1.12"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.0 || ^8.0",
        "nunomaduro/larastan": "^3.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "pestphp/pest": "^2.0 || ^3.0",
        "pestphp/pest-plugin-laravel": "^2.0 || ^3.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Wotz\\FilamentChatbot\\": "src",
            "Wotz\\FilamentChatbot\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wotz\\FilamentChatbot\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wotz\\FilamentChatbot\\Providers\\FilamentChatbotServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
