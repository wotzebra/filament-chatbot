includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    paths:
        - src
        - config
        - database
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    configDirectories:
        - config
    ignoreErrors:
        -
            identifier: trait.unused
            path: src/Livewire/Concerns/InteractsWithChatbot.php

